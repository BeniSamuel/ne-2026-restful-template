{
  "info": {
    "name": "Fire Extinguisher Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth - Login Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@tzw.test\",\"password\":\"Admin123!\"}"
        }
      }
    },
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"firstName\":\"Facility\",\"lastName\":\"Officer\",\"email\":\"facility@tzw.test\",\"password\":\"Facility123!\",\"role\":\"USER\"}"
        }
      }
    },
    {
      "name": "Users - List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users"
      }
    },
    {
      "name": "Extinguishers - Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/extinguishers",
        "body": {
          "mode": "raw",
          "raw": "{\"serialNumber\":\"TZW-FE-002\",\"location\":\"Warehouse A\",\"type\":\"FOAM\",\"size\":\"9_LBS\",\"installationDate\":\"2026-01-01\",\"expiryDate\":\"2028-01-01\",\"status\":\"ACTIVE\"}"
        }
      }
    },
    {
      "name": "Extinguishers - List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/extinguishers?page=1&limit=10&search=TZW"
      }
    },
    {
      "name": "Inspections - Schedule",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/inspections",
        "body": {
          "mode": "raw",
          "raw": "{\"extinguisherId\":\"44444444-4444-4444-4444-444444444444\",\"inspectorId\":\"22222222-2222-2222-2222-222222222222\",\"scheduledDate\":\"2026-06-10T09:00:00.000Z\",\"inspectionStatus\":\"SCHEDULED\",\"notes\":\"Monthly inspection\"}"
        }
      }
    },
    {
      "name": "Inspections - List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/inspections"
      }
    },
    {
      "name": "Maintenance - Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/maintenance",
        "body": {
          "mode": "raw",
          "raw": "{\"extinguisherId\":\"44444444-4444-4444-4444-444444444444\",\"inspectorId\":\"22222222-2222-2222-2222-222222222222\",\"actionTaken\":\"Checked pressure gauge\",\"conditionNoted\":\"Good condition\",\"actionDate\":\"2026-06-01T10:30:00.000Z\"}"
        }
      }
    },
    {
      "name": "Reports - Expired",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/reports/expired"
      }
    }
  ]
}
